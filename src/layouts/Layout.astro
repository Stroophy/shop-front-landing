---
import '../styles/global.css';
const { title } = Astro.props;
---
<html lang="en" class="scroll-smooth">
    <head>
        <meta charset="utf-8" />
        <title>{title} | PI-HUB Web Solutions</title>
    </head>
    <body class="antialiased">
        <header class="border-b border-slate-800 p-8">
            <nav class="max-w-7xl mx-auto flex justify-between items-center">
                <a href="/" class="text-3xl font-black text-white tracking-tighter">PI-HUB</a>
                <div class="space-x-8 text-sm font-bold text-slate-400">
                    <a href="/#services" class="hover:text-white">Services</a>
                    <a href="/#contact" class="bg-blue-600 text-white px-6 py-2 rounded-full hover:bg-blue-700">Get Started</a>
                </div>
            </nav>
        </header>
        <slot />
        <footer class="border-t border-slate-800 py-20 text-center text-slate-500 text-sm">
            &copy; 2026 PI-HUB Web Solutions. All Rights Reserved.
        </footer>
    </body>
</html>
