---
import '../styles/global.css';
const { title } = Astro.props;
---
<html lang="en" class="scroll-smooth bg-slate-950 text-slate-100">
    <head>
        <meta charset="utf-8" />
        <title>{title} | PI-HUB Web Solutions</title>
    </head>
    <body class="antialiased">
        <nav class="border-b border-slate-800 bg-slate-950/50 backdrop-blur-md sticky top-0 z-50">
            <div class="max-w-7xl mx-auto flex justify-between items-center p-6">
                <a href="/" class="text-3xl font-black tracking-tighter hover:text-blue-500 transition">PI-HUB</a>
                <div class="flex gap-8 text-sm font-bold text-slate-300">
                    <a href="/#services" class="hover:text-blue-500">Services</a>
                    <a href="/#contact" class="bg-blue-600 px-6 py-2 rounded-full hover:bg-blue-700 transition text-white">Contact</a>
                </div>
            </div>
        </nav>
        <slot />
        <footer class="border-t border-slate-800 py-20 text-center text-slate-500 text-sm">
            &copy; 2026 PI-HUB Web Solutions. All Rights Reserved.
        </footer>
    </body>
</html>
