---
const { title } = Astro.props;
---
<html lang="en" class="scroll-smooth">
    <head>
        <meta charset="utf-8" />
        <title>{title} | PI-HUB Web Solutions</title>
        <style is:global>
            * { box-sizing: border-box; }
            body { 
                background-color: #020617; 
                color: #f1f5f9; 
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
                margin: 0;
                /* Use the graffiti SVG pattern */
                background-image: url('/graffiti.svg');
                background-repeat: repeat;
                background-size: 300px 300px;
                background-attachment: fixed;
            }
            
            header { border-bottom: 1px solid #334155; padding: 2rem; background: #020617; }
            nav { max-width: 1200px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center; }
            .logo { font-size: 2rem; font-weight: 900; color: #fff; text-decoration: none; letter-spacing: -1px; }
            .nav-link { color: #94a3b8; font-weight: 600; text-decoration: none; margin-right: 2rem; transition: 0.3s; }
            .nav-link:hover { color: #fff; }
            .btn { background-color: #2563eb; color: #fff; padding: 0.75rem 2rem; border-radius: 9999px; font-weight: 700; text-decoration: none; transition: 0.3s; }
            .btn:hover { background-color: #1d4ed8; }

            main { max-width: 1200px; margin: 0 auto; padding: 4rem 2rem; }
            
            .grid { display: grid; grid-template-columns: repeat(1, 1fr); gap: 2rem; }
            @media (min-width: 768px) { .grid { grid-template-columns: repeat(3, 1fr); } }
            
            .tile { 
                background-color: #0f172a; 
                border: 2px solid #334155; 
                padding: 3rem; 
                border-radius: 2rem; 
                text-decoration: none; 
                color: #f1f5f9; 
                transition: 0.3s;
                display: flex;
                flex-direction: column;
                box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
            }
            .tile:hover { 
                border-color: #3b82f6; 
                transform: translateY(-10px);
                background-color: #1e293b;
            }
            .tile h3 { font-size: 1.75rem; margin-top: 0; }
            .tile p { color: #94a3b8; font-size: 1.1rem; line-height: 1.6; }
        </style>
    </head>
    <body>
        <header>
            <nav>
                <a href="/" class="logo">PI-HUB</a>
                <div>
                    <a href="/#services" class="nav-link">Services</a>
                    <a href="/#contact" class="btn">Get Started</a>
                </div>
            </nav>
        </header>
        <slot />
    </body>
</html>
