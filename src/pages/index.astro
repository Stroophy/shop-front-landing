---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Professional Web Solutions">
    <main class="max-w-7xl mx-auto px-6 py-24">
        <section class="text-center mb-32">
            <h1 class="text-7xl md:text-8xl font-black tracking-tighter leading-tight bg-gradient-to-b from-white to-slate-400 bg-clip-text text-transparent">Premium Digital Infrastructure.</h1>
            <p class="text-2xl text-slate-400 mt-8 max-w-3xl mx-auto">High-performance engineering for ambitious businesses.</p>
        </section>

        <section id="services" class="grid md:grid-cols-3 gap-8">
            {['Niche Web Assets', 'Custom Web Design', 'Managed Web Services'].map(service => (
                <a href={`/${service.toLowerCase().replace(/ /g, '-')}`} class="group relative bg-slate-900 border border-slate-800 rounded-3xl p-10 hover:border-blue-600 transition-all duration-300 overflow-hidden">
                    <div class="absolute inset-0 bg-blue-600 opacity-0 group-hover:opacity-10 transition duration-300"></div>
                    <h3 class="text-2xl font-bold mb-4">{service}</h3>
                    <p class="text-slate-400 text-lg">Click to view service details and design concepts.</p>
                </a>
            ))}
        </section>
    </main>
</Layout>
