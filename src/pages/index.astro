---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Professional Web Solutions">
    <main>
        <section style="text-align: center; margin-bottom: 6rem;">
            <h1 style="font-size: 4rem; font-weight: 900; margin-bottom: 1.5rem; letter-spacing: -2px;">Professional Digital Infrastructure.</h1>
            <p style="font-size: 1.5rem; color: #94a3b8; max-width: 800px; margin: 0 auto;">High-performance web engineering for Local Trades, Professional Consulting, and Automotive services.</p>
        </section>

        <div class="grid">
            <a href="/niche-web-assets" class="tile">
                <h3>Niche Web Assets</h3>
                <p>Engineered digital properties designed to dominate local market search and drive high-intent leads.</p>
            </a>
            <a href="/custom-web-design" class="tile">
                <h3>Custom Web Design</h3>
                <p>Bespoke brand identities and interfaces crafted for professional excellence and authority.</p>
            </a>
            <a href="/managed-web-services" class="tile">
                <h3>Managed Web Services</h3>
                <p>Comprehensive 24/7 infrastructure oversight, security hardening, and performance management.</p>
            </a>
        </div>
    </main>
</Layout>
