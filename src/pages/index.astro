---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Professional Web Solutions">
    <main>
        <section style="text-align: center; margin-bottom: 8rem;">
            <h2 style="font-size: 4.5rem; font-weight: 800; letter-spacing: -0.05em; line-height: 1.1; color: #fff;">Professional Digital Infrastructure.</h2>
            <p style="font-size: 1.5rem; color: #94a3b8; margin-top: 2rem; max-width: 800px; margin-left: auto; margin-right: auto;">High-performance web engineering for Local Trades, Professional Consulting, and Automotive services.</p>
        </section>

        <section id="services" class="grid">
            <a href="/niche-web-assets" class="service-card">
                <h3 style="font-size: 1.5rem; font-weight: 700; margin-bottom: 1.5rem;">Niche Web Assets</h3>
                <p style="color: #94a3b8; font-size: 1.125rem;">Engineered properties for specialized industries.</p>
            </a>
            <a href="/custom-web-design" class="service-card">
                <h3 style="font-size: 1.5rem; font-weight: 700; margin-bottom: 1.5rem;">Custom Web Design</h3>
                <p style="color: #94a3b8; font-size: 1.125rem;">Bespoke brand identities built for high performance.</p>
            </a>
            <a href="/managed-web-services" class="service-card">
                <h3 style="font-size: 1.5rem; font-weight: 700; margin-bottom: 1.5rem;">Managed Web Services</h3>
                <p style="color: #94a3b8; font-size: 1.125rem;">End-to-end oversight of your digital infrastructure.</p>
            </a>
        </section>
    </main>
</Layout>
