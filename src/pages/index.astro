---
import '../styles/global.css';
---
<html lang="en" class="scroll-smooth">
	<head>
		<meta charset="utf-8" />
		<title>PI-HUB | Professional Web Solutions</title>
	</head>
	<body class="bg-slate-950 text-slate-100 font-sans antialiased">
		<nav class="sticky top-0 z-50 bg-slate-950/80 backdrop-blur-md border-b border-slate-800 p-6">
            <div class="max-w-7xl mx-auto flex justify-between items-center">
                <h1 class="text-3xl font-black text-white tracking-tighter">PI-HUB</h1>
                <div class="space-x-8 text-sm font-medium text-slate-300">
                    <a href="#services" class="hover:text-white transition">Services</a>
                    <a href="#contact" class="bg-blue-600 px-6 py-2 rounded-full text-white font-bold hover:bg-blue-700 transition">Get Started</a>
                </div>
            </div>
		</nav>

		<main class="max-w-7xl mx-auto px-6 py-20">
			<section class="text-center">
				<h2 class="text-7xl font-extrabold tracking-tighter leading-[1.1]">Elevate Your Digital Presence.</h2>
				<p class="text-2xl text-slate-400 mt-8 max-w-2xl mx-auto">High-performance web solutions for modern businesses. We design, build, and maintain digital assets that drive results.</p>
			</section>

			<section id="services" class="mt-32 grid grid-cols-1 md:grid-cols-3 gap-8">
				<a href="/niche-web-assets" class="group bg-slate-900 p-10 rounded-3xl border border-slate-800 hover:border-blue-500 transition-all duration-300 shadow-2xl block">
					<h3 class="text-3xl font-extrabold mb-6 text-white group-hover:text-blue-400 transition">Niche Web Assets</h3>
					<p class="text-slate-400 text-lg leading-relaxed">Targeted, high-conversion websites optimized for specific industries and market segments.</p>
				</a>
				<a href="/custom-web-design" class="group bg-slate-900 p-10 rounded-3xl border border-slate-800 hover:border-blue-500 transition-all duration-300 shadow-2xl block">
					<h3 class="text-3xl font-extrabold mb-6 text-white group-hover:text-blue-400 transition">Custom Web Design</h3>
					<p class="text-slate-400 text-lg leading-relaxed">Bespoke, performance-optimized website templates tailored to your specific brand identity.</p>
				</a>
				<a href="/managed-web-services" class="group bg-slate-900 p-10 rounded-3xl border border-slate-800 hover:border-blue-500 transition-all duration-300 shadow-2xl block">
					<h3 class="text-3xl font-extrabold mb-6 text-white group-hover:text-blue-400 transition">Managed Web Services</h3>
					<p class="text-slate-400 text-lg leading-relaxed">Reliable, hands-off website management including hosting, maintenance, and performance monitoring.</p>
				</a>
			</section>
		</main>
	</body>
</html>
