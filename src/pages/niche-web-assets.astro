---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Niche Web Assets">
    <main class="max-w-4xl mx-auto py-16 px-6">
        <h1 class="text-5xl font-black mb-8">Niche Web Assets</h1>
        <div class="prose prose-invert prose-lg">
            <p>Our "Niche Web Assets" service is a strategic partnership designed to capture untapped digital demand. We research high-potential niches and engineer full-scale digital properties from the ground up.</p>
            <h3>What we deliver:</h3>
            <ul class="list-disc ml-6 space-y-2">
                <li><strong>Industry-Specific SEO Architecture</strong>: Keyword-mapped for your specific trades or repair sector.</li>
                <li><strong>Conversion-Oriented Funnels</strong>: Frictionless lead capture for high-intent local clients.</li>
                <li><strong>Bespoke Content Strategy</strong>: High-authority content that establishes your business as the market leader.</li>
            </ul>
        </div>
        <div class="mt-16 bg-slate-900 p-10 rounded-3xl border border-slate-700">
            <h3 class="text-xl font-bold mb-6 text-center">PI-HUB Design Concept Preview</h3>
            <div class="h-64 bg-slate-800 rounded-xl flex items-center justify-center border-2 border-dashed border-slate-600">
                <span class="text-slate-500 font-black text-2xl">PI-HUB // DESIGN CONCEPT V.01</span>
            </div>
        </div>
    </main>
</Layout>
